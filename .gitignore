cat << 'EOF' > .gitignore
# Dependencies & Virtual Environments
node_modules/
frontend/dist/
backend/venv/
backend/.venv/
__pycache__/
*.py[cod]

# Environment Variables & Secrets
.env
.env.local
frontend/.env
backend/.env

# Local Databases & Logs
*.db
*.sqlite3
*.log

# OS & Editor Files
.DS_Store
Thumbs.db
.vscode/
.idea/
EOF